<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ impose son propre écran de démarrage : impossible d'en
         changer la disposition, seulement le fond et l'icône — laquelle est
         toujours centrée.

         On lui donne donc le logo TONDE sur le fond de la marque. C'est la
         même image, à la même place et à la même taille que sur l'écran de
         marque Flutter qui prend le relais : l'utilisateur ne voit plus un
         aplat de couleur suivi d'une animation, mais une seule marque qui
         s'installe. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/tonde_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/tonde_splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tonde_splash_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tonde_splash_background</item>
    </style>
</resources>
