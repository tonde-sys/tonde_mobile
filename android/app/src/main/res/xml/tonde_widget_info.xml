<?xml version="1.0" encoding="utf-8"?>
<!--
  Métadonnées du widget.

  `updatePeriodMillis` vaut 0 volontairement : la plus petite période acceptée
  par Android est 30 minutes, ce qui est à la fois trop lent (un appel au
  guichet se joue en secondes) et trop coûteux (un réveil toutes les demi-heures
  pour un écran qui ne change pas). Le widget est donc peint à la demande, par
  `TondeWidgetProvider.refresh()` que le code Dart appelle à chaque évolution du
  ticket.

  Taille : 4 × 2 cellules, soit 250 × 110 dp selon la formule d'Android
  (70 × n − 30). C'est le plus petit format qui tienne le numéro en 34 sp et les
  deux lignes d'information sans les tronquer.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/tonde_widget_description"
    android:initialLayout="@layout/tonde_widget"
    android:minHeight="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/tonde_widget"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
